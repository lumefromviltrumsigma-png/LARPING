-- 13. Instant Interact Logic (Lag-free version)
local InstantInteractEnabled = false
local InstantInteractConn = nil
local trackedPrompts = {}

local function applyInstantPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    pcall(function()
        prompt.HoldDuration = 0
        if prompt.MaxActivationDistance < 32 then
            prompt.MaxActivationDistance = 32
        end
        prompt.RequiresLineOfSight = false
    end)
    trackedPrompts[prompt] = true
end

local function toggle_instant_interact(enabled)
    InstantInteractEnabled = enabled and true or false

    if InstantInteractConn then
        InstantInteractConn:Disconnect()
        InstantInteractConn = nil
    end

    if InstantInteractEnabled then
        task.spawn(function()
            for _, d in ipairs(Workspace:GetDescendants()) do
                if d:IsA("ProximityPrompt") then
                    applyInstantPrompt(d)
                end
                if not InstantInteractEnabled then return end
            end
        end)

        InstantInteractConn = Workspace.DescendantAdded:Connect(function(d)
            if InstantInteractEnabled and d:IsA("ProximityPrompt") then
                applyInstantPrompt(d)
            end
        end)
    else
        for prompt in pairs(trackedPrompts) do
            if prompt and prompt.Parent then
                pcall(function()
                    prompt.HoldDuration = 0.2
                end)
            end
        end
        table.clear(trackedPrompts)
    end

    PlayToggleSound()
end

