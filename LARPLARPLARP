local ArcadeAutoFarmEnabled = false
local ArcadeAutoFarmTask = nil
local ArcadeCurrentGame = nil
local ArcadeConsoleCache = nil
local ArcadeGameModule = nil

local function fn7()
    if ArcadeConsoleCache and ArcadeConsoleCache.Parent then
        return ArcadeConsoleCache
    end
    ArcadeConsoleCache = nil

    local candidates = {
        Workspace:FindFirstChild("Arcade"),
        Workspace:FindFirstChild("Arcades"),
        Workspace:FindFirstChild("Map"),
        Workspace:FindFirstChild("Interactive"),
        Workspace:FindFirstChild("Objects"),
    }

    for _, folder in ipairs(candidates) do
        if folder then
            local found = folder:FindFirstChild("Screen", true)
            if found and found.Parent then
                local parent = found.Parent
                if parent:FindFirstChild("SurfaceGui") or found:FindFirstChild("SurfaceGui") then
                    ArcadeConsoleCache = parent
                    return parent
                end
            end
        end
    end

    for _, desc in ipairs(Workspace:GetChildren()) do
        if desc:IsA("Model") or desc:IsA("Folder") then
            local screen = desc:FindFirstChild("Screen", true)
            if screen and screen:FindFirstChild("SurfaceGui") then
                ArcadeConsoleCache = screen.Parent
                return ArcadeConsoleCache
            end
        end
    end

    return nil
end

local function fn8()
    if not ArcadeGameModule then
        local ok, result = pcall(function()
            return require(ReplicatedStorage.Modules.PlayableArcadeGame)
        end)
        if not ok or not result then return end
        ArcadeGameModule = result
    end

    local console = fn7()
    if not console then return end

    local character = LocalPlayer.Character
    if not character then return end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if ArcadeCurrentGame then
        pcall(function()
            ArcadeCurrentGame.Stopping = true
            ArcadeCurrentGame:Destroy()
        end)
        ArcadeCurrentGame = nil
    end

    local v3 = ArcadeGameModule.new(console, hrp)
    ArcadeCurrentGame = v3
    v3:start()

    local now = os.clock()
    while v3.State ~= "Running" and os.clock() - now < 3 do
        if not ArcadeAutoFarmEnabled then
            pcall(function() v3:Destroy() end)
            ArcadeCurrentGame = nil
            return
        end
        task.wait(0.1)
    end

    if not ArcadeAutoFarmEnabled then
        pcall(function() v3:Destroy() end)
        ArcadeCurrentGame = nil
        return
    end

    if v3.State ~= "Running" then
        pcall(function() v3:Destroy() end)
        ArcadeCurrentGame = nil
        return
    end

    v3.Score = 4499
    if v3.ScoreLabel then
        v3.ScoreLabel.Text = "Score: 4499"
    end

    table.clear(v3.CalculateScore)
    for i = 1, 99 do
        table.insert(v3.CalculateScore, "Coin")
    end

    v3:win("You Won! Congrats! :D")
end

