-- 2. Anti Stun Logic
local harmfulEffectsList = {
    "RagdollStun", "Stun", "Stunned", "StunEffect", "StunHit",
    "Knockback", "Knockdown", "Knockout", "Dazed", "Paralyzed",
    "Freeze", "Frozen", "Sleep", "Slow", "Slowed", "Root", "Rooted"
}

local RemoveStunEnabled = false
local HeartbeatConn = nil

local function clearHarmfulEffects()
    local char = LocalPlayer.Character
    if not char then return end

    for _, effectName in ipairs(harmfulEffectsList) do
        local effect = char:FindFirstChild(effectName)
        if effect then
            pcall(function() effect:Destroy() end)
        end
    end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid:GetAttribute("Stunned") then
        humanoid:SetAttribute("Stunned", false)
    end
end

local function toggle_remove_stun(enabled)
    RemoveStunEnabled = enabled and true or false

    if HeartbeatConn then
        HeartbeatConn:Disconnect()
        HeartbeatConn = nil
    end

    if RemoveStunEnabled then
        clearHarmfulEffects()
        HeartbeatConn = RunService.Heartbeat:Connect(function()
            if RemoveStunEnabled then
                clearHarmfulEffects()
            end
        end)
    end

    PlayToggleSound()
end

