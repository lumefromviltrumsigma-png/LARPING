-- 12. Glass Vision Logic
local GlassESPEnabled = false
local FakeGlassEnabled = false
local espObjects = {}
local fakeGlassParts = {}
local espThread = nil

pcall(function()
	PhysicsService:RegisterCollisionGroup("LocalPlayerOnly")
	PhysicsService:RegisterCollisionGroup("FakeGlass")
	PhysicsService:CollisionGroupSetCollidable("FakeGlass", "Default", false)
	PhysicsService:CollisionGroupSetCollidable("FakeGlass", "LocalPlayerOnly", true)
end)

local function fn12(adornee)
	if not adornee:IsA("Model") or not adornee.PrimaryPart then
		return
	end
	local primaryPart = adornee.PrimaryPart
	local attribute = primaryPart:GetAttribute("exploitingisevil")

	if GlassESPEnabled and not espObjects[adornee] then
		local highlight = Instance.new("Highlight")
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.OutlineColor = Color3.new(1, 1, 1)

		if attribute then
			highlight.FillColor = Color3.fromRGB(255, 50, 50)
			highlight.Name = "BreakableHighlight"
		else
			highlight.FillColor = Color3.fromRGB(50, 255, 50)
			highlight.Name = "SafeHighlight"
		end

		highlight.Adornee = adornee
		highlight.Parent = adornee
		espObjects[adornee] = highlight
	end

	local v3 = FakeGlassEnabled

	if not FakeGlassEnabled then
		attribute = v3
	end

	if attribute and not fakeGlassParts[adornee] then
		local part = Instance.new("Part")
		part.Size = primaryPart.Size
		part.CFrame = primaryPart.CFrame * CFrame.new(0, 1, 0)
		part.Anchored = true
		part.CanCollide = true
		part.Transparency = 0.5
		part.Color = Color3.fromRGB(50, 255, 0)
		part.Material = Enum.Material.Glass

		pcall(function()
			part.CollisionGroup = "FakeGlass"
		end)

		part.Parent = Workspace
		fakeGlassParts[adornee] = part
	end
end

local function cleanupAll()
	for _, v3 in pairs(espObjects) do
		if v3 and v3.Parent then
			v3:Destroy()
		end
	end
	table.clear(espObjects)

	for _, v3 in pairs(fakeGlassParts) do
		if v3 and v3.Parent then
			v3:Destroy()
		end
	end
	table.clear(fakeGlassParts)
end

local function startLoop()
	if espThread then
		return
	end

	espThread = task.spawn(function()
		while GlassESPEnabled or FakeGlassEnabled do
			if Workspace:GetAttribute("GLASSBRIDGEOVER") then
				cleanupAll()
			end

			local character = LocalPlayer.Character

			if character then
				local humanoid = character:FindFirstChild("Humanoid")

				if humanoid and humanoid.Health <= 0 then
					cleanupAll()
				end
			end

			local glassBridge = Workspace:FindFirstChild("GlassBridge")

			if glassBridge then
				local glassHolder = glassBridge:FindFirstChild("GlassHolder")

				if glassHolder then
					for _, child in ipairs(glassHolder:GetChildren()) do
						for _, child2 in ipairs(child:GetChildren()) do
							fn12(child2)
						end
					end
				end
			end

			task.wait(2)
		end

		espThread = nil
	end)
end

local function toggle_glass_esp(enabled)
	GlassESPEnabled = enabled and true or false

	if GlassESPEnabled then
		startLoop()
	else
		cleanupAll()
	end
end

local fakeGlassCharConn = nil

local function toggle_fake_glass(enabled)
	FakeGlassEnabled = enabled and true or false

	if FakeGlassEnabled then
		local function applyCollision(character)
			task.spawn(function()
				task.wait(0.5)

				for _, descendant in ipairs(character:GetDescendants()) do
					if descendant:IsA("BasePart") then
						pcall(function()
							descendant.CollisionGroup = "LocalPlayerOnly"
						end)
					end
				end
			end)
		end

		if LocalPlayer.Character then
			applyCollision(LocalPlayer.Character)
		end

		fakeGlassCharConn = LocalPlayer.CharacterAdded:Connect(applyCollision)
		startLoop()
	else
		if fakeGlassCharConn then
			fakeGlassCharConn:Disconnect()
			fakeGlassCharConn = nil
		end

		cleanupAll()
	end
end

