local function AutoThrow_getClosestTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    local myHrp = char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end

    local closestTarget = nil
    local shortestDist = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetHrp = player.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = player.Character:FindFirstChildOfClass("Humanoid")
            if targetHrp and targetHum and targetHum.Health > 0 then
                local dist = (targetHrp.Position - myHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestTarget = targetHrp
                end
            end
        end
    end
    return closestTarget
end

local function AutoThrow_executeThrow()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    local targetPart = AutoThrow_getClosestTarget()
    local throwDir = targetPart and (targetPart.Position - char.HumanoidRootPart.Position).Unit or char.HumanoidRootPart.CFrame.LookVector

    pcall(function()
        local remote = tool:FindFirstChild("RemoteEvent") or ReplicatedStorage:FindFirstChild("ThrowRemote", true)
        if remote then
            remote:FireServer(throwDir, 100)
        else
            tool:Activate()
        end
    end)
end

