                Size = UDim2.new(0, 2, 0, 0)
            }):Play()
            task.delay(0.22, function()
                if SwitchCircle.Position.X.Scale < 0.5 then
                    AccentLine.Visible = false
                end
            end)
        end
    end)

    return Btn, SwitchBG, SwitchCircle
end

