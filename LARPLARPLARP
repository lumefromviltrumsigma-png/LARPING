            Size = UDim2.new(0, 28, 0, 14)
        }):Play()
    end)

    -- Track switch state via position (auto-detects when toggled)
    local lastIsOn = false
    SwitchCircle:GetPropertyChangedSignal("Position"):Connect(function()
        local isOn = SwitchCircle.Position.X.Scale >= 0.5
        if isOn == lastIsOn then return end
        lastIsOn = isOn

        if isOn then
            AccentLine.Visible = true
            TweenService:Create(AccentLine, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 2, 0, 18)
