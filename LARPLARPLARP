            if position and (position - TargetPos).Magnitude <= Radius then
                n += deltaTime
                if n >= 3.4 then
                    n = 0
                    pcall(function()
                        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TemporaryReachedBindable"):FireServer()
                    end)
                end
            else
                n = 0
            end
        end)
    end

    PlayToggleSound()
end

